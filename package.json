{
  "name": "@idea-base/mcp-server",
  "version": "2.7.1",
  "description": "MCP Server for IDEA Base - AI-powered project management. Integrates with Claude Code, Cursor, and Windsurf.",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "idea-base-mcp": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test src/*.test.js",
    "test:live": "node test/live-mcp.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.29.0"
  },
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "cursor",
    "windsurf",
    "project-management",
    "task-management",
    "time-tracking",
    "idea-base",
    "ai"
  ],
  "author": "IDEA Management LLC <support@idea-base.us>",
  "license": "MIT",
  "homepage": "https://idea-base.us",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IDEAManagement/idea-base-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/IDEAManagement/idea-base-mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "src/index.js",
    "src/cli.js",
    "src/setup.js",
    "src/features.js",
    "src/render.js",
    "src/assets/heartbeat.sh",
    "src/assets/heartbeat.provenance.json",
    "README.md",
    "LICENSE"
  ]
}
